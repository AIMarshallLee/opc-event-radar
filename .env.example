# ============================================================
# 杭州 AI / OPC 活动情报雷达系统 - 环境配置文件
# ============================================================

# 服务绑定地址与端口
RADAR_HOST=0.0.0.0
RADAR_PORT=8765

# 系统环境 (production / development)
APP_ENV=production

# 数据库存储路径 (默认为本地 SQLite WAL 模式)
DB_PATH=data/events.db

# 大模型增强评语 (可选，若不配置则自动启用内置全规则评级引擎)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# 日志级别
LOG_LEVEL=INFO
